#include <windows.h>
#include "cake32.h"

/* The original sample's resource UI remains English. */

IDR_CAKE_MENU MENU
BEGIN
    POPUP "Decoration"
    BEGIN
        MENUITEM "Settings...", IDM_SETTINGS
    END
    POPUP "Candles"
    BEGIN
        MENUITEM "Burning", IDM_BURNING
    END
END

IDD_SETTINGS DIALOG 20, 20, 172, 90
STYLE WS_POPUP | WS_DLGFRAME | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Cake Settings"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Cake text:", IDC_LABEL_CAKETEXT, 8, 10, 48, 8
    EDITTEXT        ID_CAKETEXT, 52, 8, 112, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Number of candles:", IDC_LABEL_CANDLES, 8, 28, 96, 8
    EDITTEXT        ID_NUMCANDLES, 112, 26, 48, 12, ES_AUTOHSCROLL | WS_TABSTOP
    CHECKBOX        "Flashing & Fireworks", ID_FLASH, 8, 46, 112, 12
    DEFPUSHBUTTON   "OK", IDOK, 32, 68, 48, 14
    PUSHBUTTON      "Cancel", 
IDCANCEL, 96, 68, 48, 14
END